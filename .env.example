# Copy this file to .env and fill in real values. Never commit .env.

# --- Local development ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=UTC

DB_NAME=dashboard_db
DB_USER=root
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306
# DB_SSL_CA=certs/ca.pem   (hosts that give you a certificate file, e.g. Aiven)
# DB_SSL=True              (Railway: encrypt without a certificate file)

# --- Online (set these in Vercel -> Settings -> Environment Variables) ---
# SECRET_KEY=a-new-long-random-string
# DEBUG=False
# ALLOWED_HOSTS=yourproject.vercel.app
# CSRF_TRUSTED_ORIGINS=https://yourproject.vercel.app
# BEHIND_PROXY=True
# TIME_ZONE=Africa/Nairobi
# CRON_SECRET=another-long-random-string
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME   (profile pictures online)
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=My Dashboard <you@example.com>
